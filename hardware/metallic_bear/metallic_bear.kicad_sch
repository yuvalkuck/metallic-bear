		(property "Description" "Generic Bosch BME680 gas/humidity/pressure/temperature breakout ('GY-BME680' style), 6-pin combo I2C+SPI (VCC/GND/SCL-SCK/SDA-SDI/SDO/CS). For I2C: SCL+SDA, tie CS high, SDO selects address (GND=0x76, VCC=0x77). For SPI: SCL=SCK, SDA=MOSI/SDI, SDO=MISO, CS=chip select."
			(at 228.6 129.54 90)
			(effects
				(font
					(size 1.27 1.27)
				)
				(hide yes)
			)
		)
