	(text "BME688 breakout - I2C2, 3.3 V\nSDO = GND -> address 0x76 (BME68X_I2C_ADDR_LOW), CS = 3V3 -> I2C mode\nR4/R5: fit only if the breakout has no on-board pull-ups"
		(exclude_from_sim no)
		(at 177.8 106.68 0)
